# Upstox developer app credentials
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://127.0.0.1:8000/auth/upstox/callback

# Local server
APP_HOST=127.0.0.1
APP_PORT=8000
# DATABASE_PATH=data/trade_m3.db

# Optional Telegram notifications: one bot sends each alert to both chat IDs.
# Each recipient must open your bot and tap Start before receiving messages.
# Numeric chat IDs only, not phone numbers or personal @usernames.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Example: TELEGRAM_CHAT_IDS=123456789,987654321
# A single TELEGRAM_CHAT_ID is also accepted for older .env files.
